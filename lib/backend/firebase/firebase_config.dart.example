// Template for lib/backend/firebase/firebase_config.dart.
//
// The real file is git-ignored because it holds this app's Firebase web
// options. Copy this file to firebase_config.dart and fill in the values for
// your own Firebase project (Firebase console: Project settings, Your apps,
// Web app). iOS and Android builds read their configuration from
// ios/Runner/GoogleService-Info.plist and android/app/google-services.json,
// which are git-ignored as well.

import 'package:firebase_core/firebase_core.dart';
import 'package:flutter/foundation.dart';

Future initFirebase() async {
  if (kIsWeb) {
    await Firebase.initializeApp(
        options: FirebaseOptions(
            apiKey: "YOUR_WEB_API_KEY",
            authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT_ID.firebasestorage.app",
            messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
            appId: "YOUR_WEB_APP_ID",
            measurementId: "YOUR_MEASUREMENT_ID"));
  } else {
    await Firebase.initializeApp();
  }
}
